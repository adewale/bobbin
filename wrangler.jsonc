{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bobbin",
  "main": "src/index.tsx",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public"
  },
  "vars": {
    "TOPIC_EXTRACTOR_MODE": "naive",
    "AI_GATEWAY_ID": "bobbin"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bobbin-db",
      "database_id": "b1e1d8be-b82b-4e10-a97a-37bd8d48c6f1"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "bobbin-chunks"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "SEARCH_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["0 8 * * TUE", "0 9 * * TUE"]
  },
  "queues": {
    "producers": [
      { "binding": "ENRICHMENT_QUEUE", "queue": "bobbin-enrichment" },
      { "binding": "ENRICHMENT_DLQ", "queue": "bobbin-enrichment-dlq" }
    ],
    "consumers": [
      {
        "queue": "bobbin-enrichment",
        "max_batch_size": 50,
        "max_concurrency": 20,
        "max_retries": 3,
        "retry_delay": 30,
        "dead_letter_queue": "bobbin-enrichment-dlq"
      }
    ]
  }
}
